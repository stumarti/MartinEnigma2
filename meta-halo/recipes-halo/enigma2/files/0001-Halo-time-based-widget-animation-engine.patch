 class eWidget;
 
+/*
+ * Time-based widget animation (Halo).
+ *
+ * Moves a widget from one position to another over a fixed duration in
+ * milliseconds, with an easing curve. It is driven by its own eTimer, so it
+ * works in both the immediate and the buffered composition modes. Frames are
+ * computed from the monotonic clock, so a slow frame never stretches the
+ * animation: it just skips ahead.
+ *
+ * Positions are in the same coordinates as eWidget::move().
+ */
 class eWidgetAnimation
+#ifndef SWIG
+	: public sigc::trackable
+#endif
 {
 public:
+	enum {
+		easeLinear = 0,
+		easeOutCubic = 1,
+		easeInOutCubic = 2,
+		easeOutBack = 3,
+	};
+
 	eWidgetAnimation(eWidget *widget);
+	~eWidgetAnimation();
 
+	/* Legacy frame-based API, kept for compatibility. One frame = 20 ms. */
 	void tick(int inc);
-
 	void startMoveAnimation(ePoint start, ePoint end, int length);
 
+	/* Move from start to end over durationMs, using an easing curve. */
+	void startMove(ePoint start, ePoint end, int durationMs, int easing = easeOutCubic);
+	/* Stop a running animation. jumpToEnd = 1 places the widget at its target. */
+	void stop(int jumpToEnd = 1);
+	int isRunning() const { return m_active; }
+
+	/* Frame interval in ms (default 16, about 60 fps). */
+	static void setFrameInterval(int ms);
+
 	int m_active;
+
+#ifndef SWIG
+	/* Emitted once, when an animation reaches its end (not when stopped). */
+	sigc::signal<void()> finished;
+
 private:
-	int m_move_current_tick, m_move_length;
-	ePoint m_move_start, m_move_end;
+	void onFrame();
+	void apply(double progress);
+	static double ease(int curve, double t);
+	static long elapsedMs(const timespec &since);
+
 	eWidget *m_widget;
+	ePtr<eTimer> m_timer;
+	ePoint m_move_start, m_move_end;
+	int m_duration;
+	int m_easing;
+	timespec m_start_time;
+	static int s_frame_interval;
+#endif
 };
 
 #endif
