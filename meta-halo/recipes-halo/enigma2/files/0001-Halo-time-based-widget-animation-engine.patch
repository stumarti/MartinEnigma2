-void eWidgetAnimation::startMoveAnimation(ePoint start, ePoint end, int length)
+void eWidgetAnimation::apply(double progress)
 {
-	m_move_current_tick = 0;
-	m_move_length = length;
-	m_move_start = start;
-	m_move_end = end;
-	m_active = 1;
-	m_widget->move(m_move_start);
+	double e = ease(m_easing, progress);
+	int x = m_move_start.x() + (int)((m_move_end.x() - m_move_start.x()) * e + (e >= 0 ? 0.5 : -0.5));
+	int y = m_move_start.y() + (int)((m_move_end.y() - m_move_start.y()) * e + (e >= 0 ? 0.5 : -0.5));
+	m_widget->move(ePoint(x, y));
+}
+
+double eWidgetAnimation::ease(int curve, double t)
+{
+	if (t <= 0.0)
+		return 0.0;
+	if (t >= 1.0)
+		return 1.0;
+	switch (curve)
+	{
+	case easeLinear:
+		return t;
+	case easeInOutCubic:
+		if (t < 0.5)
+			return 4.0 * t * t * t;
+		else
+		{
+			double f = -2.0 * t + 2.0;
+			return 1.0 - f * f * f / 2.0;
+		}
+	case easeOutBack:
+	{
+		const double c1 = 1.70158, c3 = c1 + 1.0;
+		double f = t - 1.0;
+		return 1.0 + c3 * f * f * f + c1 * f * f;
+	}
+	case easeOutCubic:
+	default:
+	{
+		double f = 1.0 - t;
+		return 1.0 - f * f * f;
+	}
+	}
 }
