 #include <lib/gdi/esize.h>
 #include <lib/gdi/epoint.h>
+#ifndef SWIG
+#include <lib/base/ebase.h>
+#include <lib/base/smartptr.h>
+#include <libsig_comp.h>
+#include <time.h>
