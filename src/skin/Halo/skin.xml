<?xml version="1.0" encoding="UTF-8"?>
<!--
	Halo skin (1080p). Minimal on purpose: the top menu, a slim infobar and
	the Halo settings screen. Every screen not defined here falls back to the
	emergency skin, so the box stays usable.
	Colours are #AARRGGBB with AA = 00 opaque, ff fully transparent.
-->
<skin>
	<output id="0">
		<resolution xres="1920" yres="1080" bpp="32" />
	</output>

	<parameters>
		<!-- Draw the EPG's "now" line and time ticks as plain coloured bars (no images needed). -->
		<parameter name="EPGNativeControls" value="1" />
	</parameters>

	<colors>
		<color name="haloInk" value="#00f4f6fa" />
		<color name="haloInkQuiet" value="#00aeb6c4" />
		<color name="haloGlass" value="#30121620" />
		<color name="haloAccent" value="#005b9bff" />
		<color name="haloClear" value="#ff000000" />
		<color name="haloGround" value="#00090b10" />
		<color name="haloCard" value="#00141922" />
		<color name="haloCardNow" value="#00232a35" />
		<color name="haloCardPast" value="#000e1117" />
		<color name="haloInkPast" value="#006f7889" />
		<color name="haloDark" value="#0007090c" />
		<color name="haloTick" value="#00303846" />
		<color name="haloRecord" value="#00e5484d" />
	</colors>

	<fonts>
		<font filename="LiberationSans-Regular.ttf" name="Regular" scale="100" />
		<font filename="LiberationSans-Bold.ttf" name="Bold" scale="100" />
	</fonts>

	<!-- Top menu: keep geometry in step with TopMenu.py. -->
	<screen name="HaloTopMenu" position="0,0" size="1920,180" flags="wfNoBorder" backgroundColor="haloClear">
		<eLabel name="panel" position="96,32" size="1728,112" backgroundColor="haloGlass" cornerRadius="56" zPosition="0" />
		<widget name="brand" position="136,32" size="190,112" font="Bold;34" foregroundColor="haloInk" backgroundColor="haloGlass" transparent="1" valign="center" zPosition="2" />
		<widget name="focus" position="360,52" size="200,72" backgroundColor="haloInk" cornerRadius="36" zPosition="1" />
		<widget name="item0" position="360,52" size="200,72" font="Regular;28" halign="center" valign="center" transparent="1" zPosition="2" />
		<widget name="item1" position="576,52" size="200,72" font="Regular;28" halign="center" valign="center" transparent="1" zPosition="2" />
		<widget name="item2" position="792,52" size="200,72" font="Regular;28" halign="center" valign="center" transparent="1" zPosition="2" />
		<widget name="item3" position="1008,52" size="200,72" font="Regular;28" halign="center" valign="center" transparent="1" zPosition="2" />
		<widget name="item4" position="1224,52" size="200,72" font="Regular;28" halign="center" valign="center" transparent="1" zPosition="2" />
		<widget name="item5" position="1440,52" size="200,72" font="Regular;28" halign="center" valign="center" transparent="1" zPosition="2" />
		<widget source="global.CurrentTime" render="Label" position="1660,32" size="124,112" font="Regular;30" foregroundColor="haloInk" backgroundColor="haloGlass" transparent="1" halign="right" valign="center" zPosition="2">
			<convert type="ClockToText">Format:%H:%M</convert>
		</widget>
	</screen>

	<!-- Slim infobar: channel, now and next, progress. -->
	<screen name="InfoBar" position="0,0" size="1920,1080" flags="wfNoBorder" backgroundColor="haloClear">
		<eLabel name="panel" position="96,856" size="1728,168" backgroundColor="haloGlass" cornerRadius="32" zPosition="0" />
		<widget source="session.CurrentService" render="Label" position="136,876" size="900,36" font="Regular;26" foregroundColor="haloInkQuiet" backgroundColor="haloGlass" transparent="1" zPosition="1">
			<convert type="ServiceName">Name</convert>
		</widget>
		<widget source="session.Event_Now" render="Label" position="136,914" size="1300,56" font="Bold;42" foregroundColor="haloInk" backgroundColor="haloGlass" transparent="1" zPosition="1">
			<convert type="EventName">Name</convert>
		</widget>
		<widget source="session.Event_Now" render="Progress" position="136,982" size="1100,8" foregroundColor="haloAccent" backgroundColor="#c0ffffff" cornerRadius="4" zPosition="1">
			<convert type="EventTime">Progress</convert>
		</widget>
		<widget source="session.Event_Next" render="Label" position="1270,968" size="514,36" font="Regular;24" foregroundColor="haloInkQuiet" backgroundColor="haloGlass" transparent="1" halign="right" zPosition="1">
			<convert type="EventName">Name</convert>
		</widget>
		<widget source="global.CurrentTime" render="Label" position="1600,876" size="184,40" font="Regular;30" foregroundColor="haloInk" backgroundColor="haloGlass" transparent="1" halign="right" zPosition="1">
			<convert type="ClockToText">Format:%H:%M</convert>
		</widget>
	</screen>
	<!-- TV Guide: openATV's grid EPG with the Halo look. Rows, cells, recording
	     and zapping all come from openATV; this only places and colours them. -->
	<screen name="GraphicalEPG" position="0,0" size="1920,1080" title="TV Guide" flags="wfNoBorder" backgroundColor="haloGround">
		<eLabel text="TV Guide" position="96,44" size="420,64" font="Bold;44" foregroundColor="haloInk" backgroundColor="haloGround" valign="center" />
		<widget source="Title" render="Label" position="520,44" size="1040,64" font="Regular;28" foregroundColor="haloInkQuiet" backgroundColor="haloGround" valign="center" noWrap="1" />
		<widget source="global.CurrentTime" render="Label" position="1600,44" size="224,64" font="Regular;32" foregroundColor="haloInk" backgroundColor="haloGround" halign="right" valign="center">
			<convert type="ClockToText">Format:%H:%M</convert>
		</widget>

		<!-- The highlighted programme -->
		<eLabel position="96,132" size="1728,284" backgroundColor="haloCard" cornerRadius="28" zPosition="0" />
		<widget source="Event" render="Label" position="136,156" size="90,36" font="Regular;26" foregroundColor="haloInkQuiet" backgroundColor="haloCard" transparent="1" zPosition="1">
			<convert type="EventTime">StartTime</convert>
			<convert type="ClockToText">Format:%H:%M</convert>
		</widget>
		<eLabel text="–" position="224,156" size="30,36" font="Regular;26" foregroundColor="haloInkQuiet" backgroundColor="haloCard" transparent="1" halign="center" zPosition="1" />
		<widget source="Event" render="Label" position="256,156" size="90,36" font="Regular;26" foregroundColor="haloInkQuiet" backgroundColor="haloCard" transparent="1" zPosition="1">
			<convert type="EventTime">EndTime</convert>
			<convert type="ClockToText">Format:%H:%M</convert>
		</widget>
		<widget source="Event" render="Label" position="380,156" size="1404,36" font="Regular;26" foregroundColor="haloInkQuiet" backgroundColor="haloCard" transparent="1" noWrap="1" zPosition="1">
			<convert type="EventName">GenreList</convert>
		</widget>
		<widget source="Event" render="Label" position="136,196" size="1648,64" font="Bold;46" foregroundColor="haloInk" backgroundColor="haloCard" transparent="1" noWrap="1" zPosition="1">
			<convert type="EventName">Name</convert>
		</widget>
		<widget source="Event" render="Label" position="136,268" size="1648,104" font="Regular;26" foregroundColor="haloInkQuiet" backgroundColor="haloCard" transparent="1" zPosition="1">
			<convert type="EventName">FullDescription</convert>
		</widget>
		<widget source="Event" render="Progress" position="136,388" size="1648,6" foregroundColor="haloAccent" backgroundColor="haloCardNow" cornerRadius="3" zPosition="1">
			<convert type="EventTime">Progress</convert>
		</widget>

		<!-- Time ruler, bouquet chooser and the grid -->
		<widget name="timeline_text" position="96,436" size="1728,44" itemHeight="44" TimelineFont="Regular;24" TimelineAlignment="left" foregroundColor="haloInkQuiet" backgroundColor="haloGround" borderColor="haloGround" borderWidth="0" transparent="1" zPosition="1" />
		<widget name="bouquetlist" position="96,436" size="1728,44" itemHeight="44" font="Regular;24" foregroundColor="haloInk" backgroundColor="haloCard" foregroundColorSelected="haloDark" backgroundColorSelected="haloInk" borderColor="haloGround" borderWidth="0" zPosition="3" />
		<widget name="list" position="96,488" size="1728,456" itemHeight="76" scrollbarMode="showNever" enableWrapAround="1" backgroundColor="haloGround" transparent="0"
			ServiceFontGraphical="Bold;26" EntryFontGraphical="Regular;24"
			ServiceForegroundColor="haloInk" ServiceForegroundColorNow="haloInk"
			ServiceBackgroundColor="haloCard" ServiceBackgroundColorNow="haloCardNow"
			ServiceBorderColor="haloGround" ServiceBorderWidth="4" ServiceNamePadding="16"
			EntryForegroundColor="haloInk" EntryForegroundColorSelected="haloDark"
			EntryBackgroundColor="haloCard" EntryBackgroundColorSelected="haloInk"
			EntryForegroundColorNow="haloInk" EntryForegroundColorNowSelected="haloDark"
			EntryBackgroundColorNow="haloCardNow" EntryBackgroundColorNowSelected="haloInk"
			EntryForegroundColorPast="haloInkPast" EntryForegroundColorPastSelected="haloDark"
			EntryBackgroundColorPast="haloCardPast" EntryBackgroundColorPastSelected="haloInk"
			EntryBorderColor="haloGround" EventBorderWidth="4" EventNamePadding="14"
			RecordForegroundColor="haloInk" RecordForegroundColorSelected="haloInk"
			RecordBackgroundColor="haloRecord" RecordBackgroundColorSelected="#00b8383d"
			ZapForegroundColor="haloInk" ZapForegroundColorSelected="haloDark"
			ZapBackgroundColor="#00315a8f" ZapBackgroundColorSelected="#009cc2ff" />
		<widget name="timeline_now" position="96,484" size="4,464" backgroundColor="haloAccent" zPosition="4" />
		<widget name="timeline0" position="96,488" size="1,456" backgroundColor="haloTick" zPosition="2" />
		<widget name="timeline1" position="96,488" size="1,456" backgroundColor="haloTick" zPosition="2" />
		<widget name="timeline2" position="96,488" size="1,456" backgroundColor="haloTick" zPosition="2" />
		<widget name="timeline3" position="96,488" size="1,456" backgroundColor="haloTick" zPosition="2" />
		<widget name="timeline4" position="96,488" size="1,456" backgroundColor="haloTick" zPosition="2" />
		<widget name="timeline5" position="96,488" size="1,456" backgroundColor="haloTick" zPosition="2" />
		<widget name="lab1" position="96,700" size="1728,44" font="Regular;28" foregroundColor="haloInkQuiet" backgroundColor="haloGround" transparent="1" halign="center" valign="center" zPosition="5" />

		<!-- Colour buttons -->
		<eLabel position="136,991" size="18,18" backgroundColor="#00e5484d" cornerRadius="4" />
		<widget source="key_red" render="Label" position="166,980" size="340,40" font="Regular;24" foregroundColor="haloInkQuiet" backgroundColor="haloGround" valign="center" noWrap="1" />
		<eLabel position="526,991" size="18,18" backgroundColor="#003fb950" cornerRadius="4" />
		<widget source="key_green" render="Label" position="556,980" size="340,40" font="Regular;24" foregroundColor="haloInkQuiet" backgroundColor="haloGround" valign="center" noWrap="1" />
		<eLabel position="916,991" size="18,18" backgroundColor="#00e3b341" cornerRadius="4" />
		<widget source="key_yellow" render="Label" position="946,980" size="340,40" font="Regular;24" foregroundColor="haloInkQuiet" backgroundColor="haloGround" valign="center" noWrap="1" />
		<eLabel position="1306,991" size="18,18" backgroundColor="#004c8dff" cornerRadius="4" />
		<widget source="key_blue" render="Label" position="1336,980" size="340,40" font="Regular;24" foregroundColor="haloInkQuiet" backgroundColor="haloGround" valign="center" noWrap="1" />
		<widget source="key_info" render="Label" position="1704,980" size="120,40" font="Regular;22" foregroundColor="haloInkPast" backgroundColor="haloGround" halign="right" valign="center" />
	</screen>
</skin>
