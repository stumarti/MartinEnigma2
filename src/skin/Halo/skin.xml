<?xml version="1.0" encoding="UTF-8"?>
<!--
	Halo skin (1080p). Minimal on purpose: the top menu, a slim infobar and
	the Halo settings screen. Every screen not defined here falls back to the
	emergency skin, so the box stays usable.
	Colours are #AARRGGBB with AA = 00 opaque, ff fully transparent.
-->
<skin>
	<output id="0">
		<resolution xres="1920" yres="1080" bpp="32" />
	</output>

	<colors>
		<color name="haloInk" value="#00f4f6fa" />
		<color name="haloInkQuiet" value="#00aeb6c4" />
		<color name="haloGlass" value="#30121620" />
		<color name="haloAccent" value="#005b9bff" />
		<color name="haloClear" value="#ff000000" />
	</colors>

	<fonts>
		<font filename="LiberationSans-Regular.ttf" name="Regular" scale="100" />
		<font filename="LiberationSans-Bold.ttf" name="Bold" scale="100" />
	</fonts>

	<!-- Top menu: keep geometry in step with TopMenu.py. -->
	<screen name="HaloTopMenu" position="0,0" size="1920,180" flags="wfNoBorder" backgroundColor="haloClear">
		<eLabel name="panel" position="96,32" size="1728,112" backgroundColor="haloGlass" cornerRadius="56" zPosition="0" />
		<widget name="brand" position="136,32" size="190,112" font="Bold;34" foregroundColor="haloInk" backgroundColor="haloGlass" transparent="1" valign="center" zPosition="2" />
		<widget name="focus" position="360,52" size="200,72" backgroundColor="haloInk" cornerRadius="36" zPosition="1" />
		<widget name="item0" position="360,52" size="200,72" font="Regular;28" halign="center" valign="center" transparent="1" zPosition="2" />
		<widget name="item1" position="576,52" size="200,72" font="Regular;28" halign="center" valign="center" transparent="1" zPosition="2" />
		<widget name="item2" position="792,52" size="200,72" font="Regular;28" halign="center" valign="center" transparent="1" zPosition="2" />
		<widget name="item3" position="1008,52" size="200,72" font="Regular;28" halign="center" valign="center" transparent="1" zPosition="2" />
		<widget name="item4" position="1224,52" size="200,72" font="Regular;28" halign="center" valign="center" transparent="1" zPosition="2" />
		<widget name="item5" position="1440,52" size="200,72" font="Regular;28" halign="center" valign="center" transparent="1" zPosition="2" />
		<widget source="global.CurrentTime" render="Label" position="1660,32" size="124,112" font="Regular;30" foregroundColor="haloInk" backgroundColor="haloGlass" transparent="1" halign="right" valign="center" zPosition="2">
			<convert type="ClockToText">Format:%H:%M</convert>
		</widget>
	</screen>

	<!-- Slim infobar: channel, now and next, progress. -->
	<screen name="InfoBar" position="0,0" size="1920,1080" flags="wfNoBorder" backgroundColor="haloClear">
		<eLabel name="panel" position="96,856" size="1728,168" backgroundColor="haloGlass" cornerRadius="32" zPosition="0" />
		<widget source="session.CurrentService" render="Label" position="136,876" size="900,36" font="Regular;26" foregroundColor="haloInkQuiet" backgroundColor="haloGlass" transparent="1" zPosition="1">
			<convert type="ServiceName">Name</convert>
		</widget>
		<widget source="session.Event_Now" render="Label" position="136,914" size="1300,56" font="Bold;42" foregroundColor="haloInk" backgroundColor="haloGlass" transparent="1" zPosition="1">
			<convert type="EventName">Name</convert>
		</widget>
		<widget source="session.Event_Now" render="Progress" position="136,982" size="1100,8" foregroundColor="haloAccent" backgroundColor="#c0ffffff" cornerRadius="4" zPosition="1">
			<convert type="EventTime">Progress</convert>
		</widget>
		<widget source="session.Event_Next" render="Label" position="1270,968" size="514,36" font="Regular;24" foregroundColor="haloInkQuiet" backgroundColor="haloGlass" transparent="1" halign="right" zPosition="1">
			<convert type="EventName">Name</convert>
		</widget>
		<widget source="global.CurrentTime" render="Label" position="1600,876" size="184,40" font="Regular;30" foregroundColor="haloInk" backgroundColor="haloGlass" transparent="1" halign="right" zPosition="1">
			<convert type="ClockToText">Format:%H:%M</convert>
		</widget>
	</screen>
</skin>
